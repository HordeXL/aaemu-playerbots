/target/
# machine-local cargo settings (target-dir on another drive, jobs)
/.cargo/config.toml
# baked world data (heights, map, polygons) - produced by `playerbots bake`
/data/
# local configuration, roster and secrets
/playerbots.toml
/roster.json
# the generated bot password (next to the roster)
*.secrets.json
*.local.toml
.env
